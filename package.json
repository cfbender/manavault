{
  "name": "manavault",
  "version": "2.0.0",
  "private": true,
  "description": "ManaVault React frontend and Capacitor native shell tooling for the Rust backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "vp lint",
    "precommit": "mise run precommit",
    "format": "vp fmt",
    "typecheck": "tsc --project assets/tsconfig.json --noEmit",
    "test:react": "node --test assets/react/test/*.test.mjs && vitest run --config vitest.config.ts",
    "codegen": "mkdir -p rust/target && cargo run --manifest-path rust/Cargo.toml --locked --quiet --bin manavault -- sdl > rust/target/graphql-schema.graphql && graphql-codegen --config codegen.ts",
    "native:prepare": "node scripts/prepare-native-web.mjs",
    "cap:sync": "aube run native:prepare && cap sync",
    "cap:sync:android": "aube run native:prepare && cap sync android",
    "cap:sync:ios": "aube run native:prepare && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "aube run cap:sync:android && cap run android",
    "cap:run:ios": "aube run cap:sync:ios && cap run ios",
    "android:build:debug": "aube run cap:sync:android && ./android/gradlew -p android assembleDebug",
    "android:build:release": "aube run cap:sync:android && ./android/gradlew -p android assembleRelease",
    "android:signing:setup": "node scripts/create-android-keystore.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.3.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "ogl": "^1.0.11",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^8.3.2",
    "vite-plus": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@voidzero-dev/vite-plus-core": "^1.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@babel/runtime@^7": "7.29.7",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "nanoid@^3": "3.3.19",
    "tar": "7.5.22",
    "undici": "7.30.0",
    "uuid": "11.1.1"
  }
}
